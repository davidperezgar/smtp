{
  "name": "wordpress/smtp",
  "description": "Send WordPress emails through an SMTP server, with an extensible provider API and a simple email log.",
  "license": "GPL-2.0-or-later",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.2.0"
  },
  "autoload": {
    "psr-4": {
      "WordPress\\SMTP\\": "includes/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4"
    },
    "sort-packages": true,
    "autoloader-suffix": "SMTP_Plugin"
  },
  "scripts": {
    "format": "phpcbf --standard=phpcs.xml.dist",
    "lint": "phpcs --standard=phpcs.xml.dist"
  },
  "scripts-descriptions": {
    "format": "Detect and automatically fix most coding standards issues",
    "lint": "Detect coding standards issues"
  }
}
